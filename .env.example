# Optional overrides. `docker compose up --build -d` works without this file.
# Database credentials are generated into a Docker volume, never this repository.
WEB_PORT=3000
API_PORT=8000
POSTGRES_DB=signalrank
POSTGRES_USER=signalrank
DATASET_URL=https://files.grouplens.org/datasets/movielens/ml-latest-small.zip
# Required archive checksum; defaults to the independently published MovieLens checksum.
# Only this exact archive may use the built-in HTTPS fallback mirror.
DATASET_SHA256=696d65a3dfceac7c45750ad32df2c259311949efec81f0f144fdfb91ebc9e436
